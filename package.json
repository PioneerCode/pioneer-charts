{
  "name": "pioneer-charts",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "ng serve pioneer-charts-docs",
    "start-components": "ng build @pioneer-code/pioneer-charts --watch",
    "build:docs": "ng build pioneer-charts-docs ",
    "build:lib": "npm run build:lib:package && npm run build:lib:sass && npm run build:lib:theme && npm run build:lib:exports && npm run build:lib:readme",
    "build:lib:publish": "npm run build:lib && npm publish ./dist/pioneer-charts --access public",
    "build:lib:readme": "node ./build/readme.js",
    "build:lib:package": "ng build @pioneer-code/pioneer-charts",
    "build:lib:theme": "node ./build/theme.js",
    "build:lib:sass": "node ./build/sass.js",
    "build:lib:exports": "node ./build/exports.js"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.2",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@tailwindcss/postcss": "^4.1.18",
    "postcss": "^8.5.6",
    "rxjs": "~7.5.0",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "~22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.5.2",
    "cpy": "^12.0.1",
    "d3": "^7.9.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.0.0",
    "postcss": "^8.5.3",
    "sass": "^1.97.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
